{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/health/live",
      "destination": "https://lexa-backend-api-live.onrender.com/health/live"
    },
    {
      "source": "/api/v1/health/ready",
      "destination": "https://lexa-backend-api-live.onrender.com/health/ready"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://lexa-backend-api-live.onrender.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
