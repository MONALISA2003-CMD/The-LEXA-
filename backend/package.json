{
  "name": "@lexa/backend",
  "version": "0.1.0",
  "private": true,
  "description": "LEXA multi-tenant ERP API \u2014 foundation scaffold",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "test": "node --test test/*.test.mjs",
    "db:migrate:status": "prisma migrate status",
    "db:verify": "node scripts/verify-schema-integrity.mjs",
    "contract:check": "python scripts/check-openapi-coverage.py",
    "ledger:coverage": "node scripts/verify-ledger-posting-coverage.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-fastify": "^11.2.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
