# LEXA backend — copy to .env for local development only.
# Never commit real credentials, and never use a production database for local migrations.
NODE_ENV=development
PORT=10000
APP_VERSION=local
DATABASE_URL=postgresql://lexa_app:REPLACE_ME@YOUR_NEON_HOST/lexa?sslmode=verify-full
# Enable only after the runtime grants and RLS policies have been applied.
DATABASE_RUNTIME_ROLE=lexa_app_runtime
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_PUBLIC_URL=https://your-frontend.example

# Transactional email. Use only after verifying your sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Private platform storage and background worker (server-side worker secrets only).
REDIS_URL=redis://localhost:6379
WORKER_DATABASE_URL=
WORKER_TENANT_DATABASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=lexa-private-platform-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_VERSION=v1
PLATFORM_RESTORE_ENABLED=false
RESTORE_TARGET_PROJECT_ID=
RESTORE_TARGET_BRANCH_ID=
RESTORE_TARGET_DATABASE_URL=
PRODUCTION_NEON_PROJECT_ID=
PRODUCTION_NEON_BRANCH_ID=

# Optional locally; set true in production policy after both providers are configured.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_SERVICE_NAME=lexa-api
OBSERVABILITY_REQUIRED_IN_PRODUCTION=false
METRICS_TOKEN=
