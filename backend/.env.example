# LEXA backend — copy to .env for local development only.
# Never commit real credentials, and never use a production database for local migrations.
NODE_ENV=development
PORT=10000
APP_VERSION=local
# Runtime URL: use the pooled Neon hostname (the endpoint name contains -pooler).
DATABASE_URL=postgresql://lexa_app:REPLACE_ME@YOUR_NEON_ENDPOINT-pooler.YOUR_NEON_REGION.aws.neon.tech/lexa?sslmode=require
# Prisma CLI only: direct/unpooled host (no -pooler), for migrate deploy/status/introspection.
DATABASE_URL_UNPOOLED=postgresql://lexa_app:REPLACE_ME@YOUR_NEON_ENDPOINT.YOUR_NEON_REGION.aws.neon.tech/lexa?sslmode=require
# The login role is lexa_app; application queries switch to this granted least-privilege role per transaction.
# Do not add a role startup option to either connection URL.
DATABASE_RUNTIME_ROLE=lexa_app_runtime
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_PUBLIC_URL=https://your-frontend.example

# Transactional email. Use only after verifying your sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Private platform storage and background worker (server-side worker secrets only).
REDIS_URL=redis://localhost:6379
WORKER_DATABASE_URL=
WORKER_TENANT_DATABASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=lexa-private-platform-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_VERSION=v1
PLATFORM_RESTORE_ENABLED=false
RESTORE_TARGET_PROJECT_ID=
RESTORE_TARGET_BRANCH_ID=
RESTORE_TARGET_DATABASE_URL=
PRODUCTION_NEON_PROJECT_ID=
PRODUCTION_NEON_BRANCH_ID=

# Optional locally; set true in production policy after both providers are configured.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_SERVICE_NAME=lexa-api
OBSERVABILITY_REQUIRED_IN_PRODUCTION=false
METRICS_TOKEN=

# LEXA single-service AI router. Provider credentials are server-side only.
# Paid-tier keys are stored for the future production phase but are not routed while the paid tier is false.
LEXA_AI_ENABLED=true
LEXA_AI_PAID_TIER_ENABLED=false
LEXA_AI_PUBLIC_HELP_CONFIGURED=true
LEXA_AI_BUSINESS_CONFIGURED=true
GEMINI_FREE_API_KEY=
GEMINI_FREE_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_FREE_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
