function sha256(value: string): string {
  return createHash('sha256').update(value).digest('hex');
}

function passwordForVerification(value: unknown): string {
  if (typeof value !== 'string' || value.length === 0 || value.length > 1024) {
    throw new BadRequestException('Enter your current password.');
  }
  return value;
}

function newPasswordValue(value: unknown): string {
  if (typeof value !== 'string') throw new BadRequestException('Enter a new password or passphrase.');
  const normalized = value.normalize('NFKC');
  const length = Array.from(normalized).length;
  if (length < 15) throw new BadRequestException('Use a password or passphrase with at least 15 characters.');
  if (length > 1024 || /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/u.test(normalized)) {
    throw new BadRequestException('The password contains unsupported characters or is too long.');
  }
  if (BLOCKLISTED_PASSWORDS.has(normalized.toLowerCase())) {
    throw new BadRequestException('Choose a less common password or passphrase.');
  }
  return normalized;
}

function escapeEmailHtml(value: string): string {
  return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] ?? char);
}
