  private async passwordHash(password: string): Promise<string> {
    const normalized = newPasswordValue(password);
    const salt = randomBytes(16);
    const derived = await scrypt(normalized, salt, 64) as Buffer;
    return `${salt.toString('hex')}:${derived.toString('hex')}`;
  }

  private async passwordMatches(password: string, encoded: string | null): Promise<boolean> {
    if (!encoded) return false;
    const [saltHex, hashHex] = encoded.split(':');
    if (!saltHex || !hashHex) return false;
    try {
      const expected = Buffer.from(hashHex, 'hex');
      const salt = Buffer.from(saltHex, 'hex');
      // Try normalized and original values to preserve sign-in for accounts created before this policy.
      const candidates = [...new Set([password.normalize('NFKC'), password])];
      for (const candidate of candidates) {
        const actual = await scrypt(candidate, salt, expected.length) as Buffer;
        if (expected.length === actual.length && timingSafeEqual(expected, actual)) return true;
      }
      return false;
    } catch { return false; }
  }

  private authRateCleanupCount = 0;

  private async consumeAuthRateLimit(key: string, limit: number, windowMs: number): Promise<boolean> {
    const rows = await this.prisma.$queryRawUnsafe<Array<{ allowed: boolean }>>(
      `INSERT INTO "auth_rate_limits" ("key", "attempts", "window_started_at", "updated_at")
       VALUES ($1, 1, NOW(), NOW())
       ON CONFLICT ("key") DO UPDATE SET
         "attempts" = CASE WHEN "auth_rate_limits"."window_started_at" <= NOW() - ($3 * INTERVAL '1 millisecond') THEN 1 ELSE "auth_rate_limits"."attempts" + 1 END,
         "window_started_at" = CASE WHEN "auth_rate_limits"."window_started_at" <= NOW() - ($3 * INTERVAL '1 millisecond') THEN NOW() ELSE "auth_rate_limits"."window_started_at" END,
         "updated_at" = NOW()
       RETURNING ("attempts" <= $2) AS "allowed"`,
      key, limit, windowMs,
    );
    this.authRateCleanupCount += 1;
    if (this.authRateCleanupCount >= AUTH_RATE_CLEANUP_INTERVAL) {
      this.authRateCleanupCount = 0;
      void this.prisma.authRateLimit.deleteMany({ where: { updatedAt: { lt: new Date(Date.now() - 30 * 24 * 60 * 60 * 1000) } } }).catch(() => undefined);
    }
    return rows[0]?.allowed === true;
  }

  private authIp(request: FastifyRequest): string {
    const forwarded = request.headers['x-forwarded-for'];
    const firstForwarded = typeof forwarded === 'string' ? forwarded.split(',')[0]?.trim() : undefined;
    return (request.ip || firstForwarded || 'unknown').slice(0, 128);
  }

  private authRateKey(kind: string, value: string): string {
    return `${kind}:${sha256(value.trim().toLowerCase())}`;
  }

  private async deliverSecurityEmail(to: string, subject: string, html: string, text: string): Promise<void> {
    const apiKey = process.env.RESEND_API_KEY;
    const from = process.env.PASSWORD_RESET_FROM_EMAIL;
    if (!apiKey || !from) throw new ServiceUnavailableException({ code: 'PASSWORD_RESET_DELIVERY_NOT_CONFIGURED', message: 'Password recovery email is not configured. Contact your LEXA administrator.' });
    const response = await fetch('https://api.resend.com/emails', {
      method: 'POST',
      headers: { authorization: `Bearer ${apiKey}`, 'content-type': 'application/json' },
      body: JSON.stringify({ from, to: [to], subject, html, text }),
    });
    if (!response.ok) throw new Error(`Resend email delivery returned ${response.status}`);
  }

  private async sendPasswordChangedNotice(email: string, displayName?: string | null): Promise<void> {
    const name = escapeEmailHtml(displayName || 'there');
    const html = `<!doctype html><html><body style="margin:0;background:#f4f7fc;font-family:Arial,sans-serif;color:#10264a"><div style="max-width:560px;margin:32px auto;background:#fff;border:1px solid #e0e8f3;border-radius:16px;padding:32px"><p style="font-weight:800;letter-spacing:2px;color:#075cf5">LEXA</p><h1 style="font-size:24px">Your password was changed</h1><p>Hello ${name},</p><p>Your LEXA account password was updated. All other active sessions have been signed out.</p><p>If you did not make this change, contact your LEXA administrator immediately.</p></div></body></html>`;
    const body = `Hello ${displayName || 'there'},\n\nYour LEXA account password was updated. All other active sessions have been signed out.\n\nIf you did not make this change, contact your LEXA administrator immediately.`;
    await this.deliverSecurityEmail(email, 'Your LEXA password was changed', html, body);
  }
