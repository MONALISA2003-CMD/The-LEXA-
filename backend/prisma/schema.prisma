generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum StockMovementType {
  opening
  receiving
  sale
  return
  adjustment
  transfer_in
  transfer_out
  write_off
  supplier_return
  production_issue
  production_receipt
  count_adjustment
  quarantine
  release
}

model Tenant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  businessType       String              @default("general") @map("business_type")
  currency           String              @default("UGX")
  timezone           String              @default("Africa/Kampala")
  enabledModules     String[]            @default([]) @map("enabled_modules")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  branches           Branch[]
  ledgerAccounts     LedgerAccount[]
  accountingPeriods  AccountingPeriod[]
  ledgerJournals     LedgerJournal[]
  auditEvents        AuditEvent[]
  idempotencyRecords IdempotencyRecord[]
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  categories         Category[]
  products           Product[]
  moduleRecords      ModuleRecord[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleLines          SaleLine[]
  salePayments       SalePayment[]
  saleReturns        SaleReturn[]
  saleReturnLines    SaleReturnLine[]

  @@map("tenants")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  displayName        String?              @map("display_name")
  passwordHash       String?              @map("password_hash")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  auditEvents        AuditEvent[]        @relation("AuditActor")
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  branchGrantsCreated BranchMembership[] @relation("BranchGrantCreator")
  accountingPeriodsClosed AccountingPeriod[] @relation("AccountingPeriodCloser")
  ledgerJournalsCreated LedgerJournal[] @relation("LedgerJournalCreator")
  ledgerJournalsPosted LedgerJournal[] @relation("LedgerJournalPoster")

  @@map("users")
}

model Membership {
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      String           @default("member")
  status    MembershipStatus @default(INVITED)
  branchScopeMode String     @default("all") @map("branch_scope_mode")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchAccesses BranchMembership[]

  @@id([tenantId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Branch {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  code           String
  name           String
  address        String?
  timezone       String         @default("Africa/Kampala")
  currency       String         @default("UGX")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchMemberships BranchMembership[]
  ledgerJournals LedgerJournal[]
  moduleRecords  ModuleRecord[]
  stockMovements StockMovement[]
  sales          Sale[]
  saleReturns    SaleReturn[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("branches")
}

model BranchMembership {
  tenantId        String     @map("tenant_id") @db.Uuid
  branchId        String     @map("branch_id") @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUserId String?    @map("created_by_user_id") @db.Uuid
  membership      Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  branch          Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  createdByUser   User?       @relation("BranchGrantCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([tenantId, branchId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, branchId])
  @@map("branch_memberships")
}

model LedgerAccount {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  accountCode   String   @map("account_code")
  accountName   String   @map("account_name")
  accountType   String   @map("account_type")
  normalBalance String   @map("normal_balance")
  systemKey     String?  @map("system_key")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journalLines  LedgerJournalLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, accountCode])
  @@unique([tenantId, systemKey])
  @@index([tenantId, accountType, accountCode])
  @@map("ledger_accounts")
}

model AccountingPeriod {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  periodKey       String    @map("period_key")
  startsOn        DateTime  @map("starts_on") @db.Date
  endsOn          DateTime  @map("ends_on") @db.Date
  status          String    @default("open")
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(3)
  closedByUserId  String?   @map("closed_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  closedByUser    User?     @relation("AccountingPeriodCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, periodKey])
  @@index([tenantId, startsOn, endsOn])
  @@map("accounting_periods")
}

model LedgerJournal {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  journalNumber    String              @map("journal_number")
  entryDate        DateTime            @map("entry_date") @db.Date
  memo             String
  sourceType       String?             @map("source_type")
  sourceId         String?             @map("source_id")
  status           String              @default("draft")
  reversalOfId     String?             @map("reversal_of_id") @db.Uuid
  idempotencyKey   String?             @map("idempotency_key")
  requestHash      String?             @map("request_hash")
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  postedByUserId   String?             @map("posted_by_user_id") @db.Uuid
  postedAt         DateTime?           @map("posted_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch           Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  createdByUser    User                @relation("LedgerJournalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedByUser     User?               @relation("LedgerJournalPoster", fields: [postedByUserId], references: [id], onDelete: Restrict)
  reversalOf       LedgerJournal?      @relation("LedgerJournalReversals", fields: [tenantId, reversalOfId], references: [tenantId, id], onDelete: Restrict)
  reversals        LedgerJournal[]     @relation("LedgerJournalReversals")
  lines            LedgerJournalLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, journalNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, entryDate])
  @@index([tenantId, status, entryDate])
  @@map("ledger_journals")
}

model LedgerJournalLine {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  journalId   String        @map("journal_id") @db.Uuid
  lineNumber  Int           @map("line_number")
  accountId   String        @map("account_id") @db.Uuid
  description String?
  debitMinor  BigInt        @default(0) @map("debit_minor")
  creditMinor BigInt        @default(0) @map("credit_minor")
  journal     LedgerJournal @relation(fields: [tenantId, journalId], references: [tenantId, id], onDelete: Restrict)
  account     LedgerAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, journalId, lineNumber])
  @@index([tenantId, accountId, journalId])
  @@map("ledger_journal_lines")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  key            String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  name               String
  sku                String
  barcode            String?
  brand              String?
  unitOfMeasure      String?   @map("unit_of_measure")
  unitOfMeasureId    String?   @map("unit_of_measure_id") @db.Uuid
  defaultTaxCodeId   String?   @map("default_tax_code_id") @db.Uuid
  trackLot           Boolean   @default(false) @map("track_lot")
  trackSerial        Boolean   @default(false) @map("track_serial")
  supplierSku        String?   @map("supplier_sku")
  categoryId         String?   @map("category_id") @db.Uuid
  costPriceMinor     Int       @default(0) @map("cost_price_minor")
  sellingPriceMinor  Int       @default(0) @map("selling_price_minor")
  lowStockThreshold  Decimal   @default(0) @map("low_stock_threshold") @db.Decimal(12, 3)
  trackStock         Boolean   @default(true) @map("track_stock")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements     StockMovement[]
  saleLines          SaleLine[]
  saleReturnLines    SaleReturnLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@index([tenantId, categoryId])
  @@map("products")
}

model ModuleRecord {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  moduleId  String   @map("module_id")
  recordId  String   @map("record_id")
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, moduleId, recordId])
  @@index([tenantId, branchId, moduleId, updatedAt])
  @@map("module_records")
}


model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  productId    String            @map("product_id") @db.Uuid
  type         StockMovementType
  quantityDelta Decimal          @map("quantity_delta") @db.Decimal(12, 3)
  unitCostMinor  Int              @default(0) @map("unit_cost_minor")
  warehouseId    String?          @map("warehouse_id") @db.Uuid
  binId          String?          @map("bin_id") @db.Uuid
  lotId          String?          @map("lot_id") @db.Uuid
  variantId      String?          @map("variant_id") @db.Uuid
  serialId       String?          @map("serial_id") @db.Uuid
  reason       String
  sourceId     String?           @map("source_id")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, branchId, productId, createdAt])
  @@map("stock_movements")
}

model Sale {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  branchId            String          @map("branch_id") @db.Uuid
  receiptNumber       String          @map("receipt_number")
  customerName        String?         @map("customer_name")
  customerPhone       String?         @map("customer_phone")
  promisedPaymentDate DateTime?       @map("promised_payment_date") @db.Date
  totalMinor          Int             @map("total_minor")
  status              String          @default("completed")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines               SaleLine[]
  payments            SalePayment[]
  returns             SaleReturn[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, branchId, createdAt])
  @@map("sales")
}

model SaleLine {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  saleId              String   @map("sale_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  unitOfMeasureId     String?  @map("unit_of_measure_id") @db.Uuid
  taxCodeId           String?  @map("tax_code_id") @db.Uuid
  taxRateBasisPoints  Int      @default(0) @map("tax_rate_basis_points")
  taxMinor            Int      @default(0) @map("tax_minor")
  priceListId         String?  @map("price_list_id") @db.Uuid
  lotId               String?  @map("lot_id") @db.Uuid
  serialIds           String[] @default([]) @map("serial_ids") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  quantity            Decimal  @db.Decimal(12, 3)
  unitCostMinor       Int      @default(0) @map("unit_cost_minor")
  unitPriceMinor      Int      @map("unit_price_minor")
  lineTotalMinor      Int      @map("line_total_minor")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnLines         SaleReturnLine[]

  @@index([tenantId, saleId])
  @@map("sale_lines")
}

model SalePayment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  saleId     String   @map("sale_id") @db.Uuid
  kind       String   @default("receipt")
  method     String
  amountMinor Int     @map("amount_minor")
  reference  String?
  ledgerSource String? @map("ledger_source")
  cashSessionId String? @map("cash_session_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, saleId, createdAt])
  @@map("sale_payments")
}

model SaleReturn {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  saleId         String            @map("sale_id") @db.Uuid
  returnNumber   String            @map("return_number")
  totalMinor     Int               @map("total_minor")
  reason         String
  refundRecorded Boolean           @default(false) @map("refund_recorded")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale           Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  lines          SaleReturnLine[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, saleId, createdAt])
  @@map("sale_returns")
}

model SaleReturnLine {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  returnId            String         @map("return_id") @db.Uuid
  originalSaleLineId  String         @map("original_sale_line_id") @db.Uuid
  productId           String         @map("product_id") @db.Uuid
  productNameSnapshot String         @map("product_name_snapshot")
  quantity            Decimal        @db.Decimal(12, 3)
  unitPriceMinor      Int            @map("unit_price_minor")
  lineTotalMinor      Int            @map("line_total_minor")
  disposition         String         @default("restock")
  serialIds           String[]       @default([]) @map("serial_ids") @db.Uuid
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returnRecord        SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  originalSaleLine    SaleLine       @relation(fields: [originalSaleLineId], references: [id], onDelete: Restrict)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, returnId])
  @@index([tenantId, originalSaleLineId])
  @@map("sale_return_lines")
}

model WorkspaceInvitation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  email String
  role String
  branchScopeMode String @default("all") @map("branch_scope_mode")
  branchIds String[] @default([]) @map("branch_ids")
  tokenHash String @unique @map("token_hash")
  idempotencyKey String @map("idempotency_key")
  requestHash String @map("request_hash")
  status String @default("PENDING")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  invitedByUserId String @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String? @map("accepted_by_user_id") @db.Uuid
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, email, status])
  @@index([tenantId, expiresAt])
  @@map("workspace_invitations")
}

model UnitOfMeasure {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code String
  name String
  dimension String @default("quantity")
  precision Int @default(3)
  active Boolean @default(true)
  @@unique([tenantId, code])
  @@map("unit_of_measures")
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  sku String
  barcode String?
  attributes Json @default("{}")
  costPriceMinor Int @default(0) @map("cost_price_minor")
  sellingPriceMinor Int @default(0) @map("selling_price_minor")
  active Boolean @default(true)
  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model TaxCode {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code String
  name String
  rateBasisPoints Int @map("rate_basis_points")
  calculation String @default("exclusive")
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo DateTime? @map("effective_to") @db.Date
  active Boolean @default(true)
  @@unique([tenantId, code])
  @@map("tax_codes")
}

