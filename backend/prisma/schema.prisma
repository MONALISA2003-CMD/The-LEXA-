generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum StockMovementType {
  opening
  receiving
  sale
  return
  adjustment
  transfer_in
  transfer_out
  write_off
  supplier_return
  production_issue
  production_receipt
  count_adjustment
  quarantine
  release
}

model Tenant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  businessType       String              @default("general") @map("business_type")
  currency           String              @default("UGX")
  timezone           String              @default("Africa/Kampala")
  enabledModules     String[]            @default([]) @map("enabled_modules")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  branches           Branch[]
  businessProfile    BusinessProfile?
  businessPaymentMethods BusinessPaymentMethod[]
  ledgerAccounts     LedgerAccount[]
  accountingPeriods  AccountingPeriod[]
  ledgerJournals     LedgerJournal[]
  auditEvents        AuditEvent[]
  idempotencyRecords IdempotencyRecord[]
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  categories         Category[]
  products           Product[]
  moduleRecords      ModuleRecord[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleLines          SaleLine[]
  salePayments       SalePayment[]
  saleReturns        SaleReturn[]
  saleReturnLines    SaleReturnLine[]

  @@map("tenants")
}


// One verified business identity per tenant. This is not a second workspace.
model BusinessProfile {
  tenantId                   String    @id @map("tenant_id") @db.Uuid
  tradingName                String?   @map("trading_name")
  legalName                  String?   @map("legal_name")
  country                    String    @default("UG")
  district                   String? 
  city                       String?
  physicalAddress            String?   @map("physical_address")
  onlineOnly                 Boolean   @default(false) @map("online_only")
  email                      String?
  phone                      String?
  website                    String?
  registrationNumber         String?   @map("registration_number")
  taxIdentificationNumber    String?   @map("tax_identification_number")
  industry                   String?
  industries                 String[]  @default([])
  businessModels             String[]  @default([]) @map("business_models")
  offeringTypes              String[]  @default([]) @map("offering_types")
  offeringsDescription       String?   @map("offerings_description")
  sellingChannels            String[]  @default([]) @map("selling_channels")
  setupStep                  Int       @default(1) @map("setup_step")
  completedAt                DateTime? @map("completed_at") @db.Timestamptz(3)
  manualPaymentsConfirmedAt  DateTime? @map("manual_payments_confirmed_at") @db.Timestamptz(3)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// Payment options only: neither this table nor its API initiates or verifies transfers.
model BusinessPaymentMethod {
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  label     String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, code])
  @@index([tenantId, enabled])
  @@map("business_payment_methods")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  displayName        String?              @map("display_name")
  passwordHash       String?              @map("password_hash")
  username           String?              @unique
  mustChangePassword Boolean              @default(false) @map("must_change_password")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  auditEvents        AuditEvent[]        @relation("AuditActor")
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  branchGrantsCreated BranchMembership[] @relation("BranchGrantCreator")
  accountingPeriodsClosed AccountingPeriod[] @relation("AccountingPeriodCloser")
  ledgerJournalsCreated LedgerJournal[] @relation("LedgerJournalCreator")
  ledgerJournalsPosted LedgerJournal[] @relation("LedgerJournalPoster")

  @@map("users")
}

model Membership {
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      String           @default("member")
  status    MembershipStatus @default(INVITED)
  branchScopeMode String     @default("all") @map("branch_scope_mode")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchAccesses BranchMembership[]

  @@id([tenantId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Branch {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  code           String
  name           String
  address        String?
  timezone       String         @default("Africa/Kampala")
  currency       String         @default("UGX")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchMemberships BranchMembership[]
  ledgerJournals LedgerJournal[]
  moduleRecords  ModuleRecord[]
  stockMovements StockMovement[]
  sales          Sale[]
  saleReturns    SaleReturn[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("branches")
}

model BranchMembership {
  tenantId        String     @map("tenant_id") @db.Uuid
  branchId        String     @map("branch_id") @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUserId String?    @map("created_by_user_id") @db.Uuid
  membership      Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  branch          Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  createdByUser   User?       @relation("BranchGrantCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([tenantId, branchId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, branchId])
  @@map("branch_memberships")
}

model LedgerAccount {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  accountCode   String   @map("account_code")
  accountName   String   @map("account_name")
  accountType   String   @map("account_type")
  normalBalance String   @map("normal_balance")
  systemKey     String?  @map("system_key")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journalLines  LedgerJournalLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, accountCode])
  @@unique([tenantId, systemKey])
  @@index([tenantId, accountType, accountCode])
  @@map("ledger_accounts")
}

model AccountingPeriod {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  periodKey       String    @map("period_key")
  startsOn        DateTime  @map("starts_on") @db.Date
  endsOn          DateTime  @map("ends_on") @db.Date
  status          String    @default("open")
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(3)
  closedByUserId  String?   @map("closed_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  closedByUser    User?     @relation("AccountingPeriodCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, periodKey])
  @@index([tenantId, startsOn, endsOn])
  @@map("accounting_periods")
}

model LedgerJournal {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  journalNumber    String              @map("journal_number")
  entryDate        DateTime            @map("entry_date") @db.Date
  memo             String
  sourceType       String?             @map("source_type")
  sourceId         String?             @map("source_id")
  status           String              @default("draft")
  reversalOfId     String?             @map("reversal_of_id") @db.Uuid
  idempotencyKey   String?             @map("idempotency_key")
  requestHash      String?             @map("request_hash")
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  postedByUserId   String?             @map("posted_by_user_id") @db.Uuid
  postedAt         DateTime?           @map("posted_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch           Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  createdByUser    User                @relation("LedgerJournalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedByUser     User?               @relation("LedgerJournalPoster", fields: [postedByUserId], references: [id], onDelete: Restrict)
  reversalOf       LedgerJournal?      @relation("LedgerJournalReversals", fields: [tenantId, reversalOfId], references: [tenantId, id], onDelete: Restrict)
  reversals        LedgerJournal[]     @relation("LedgerJournalReversals")
  lines            LedgerJournalLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, journalNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, entryDate])
  @@index([tenantId, status, entryDate])
  @@map("ledger_journals")
}

model LedgerJournalLine {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  journalId   String        @map("journal_id") @db.Uuid
  lineNumber  Int           @map("line_number")
  accountId   String        @map("account_id") @db.Uuid
  description String?
  debitMinor  BigInt        @default(0) @map("debit_minor")
  creditMinor BigInt        @default(0) @map("credit_minor")
  journal     LedgerJournal @relation(fields: [tenantId, journalId], references: [tenantId, id], onDelete: Restrict)
  account     LedgerAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, journalId, lineNumber])
  @@index([tenantId, accountId, journalId])
  @@map("ledger_journal_lines")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  key            String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

/** Email possession is established before any user, tenant, or owner membership exists. */
model SignupVerification {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  businessName String   @map("business_name")
  businessType String   @default("general") @map("business_type")
  passwordHash String   @map("password_hash")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("signup_verifications")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  templateKey String? @map("template_key")
  // Optional Phase 1 V2 reference; historical category IDs and paths are unchanged.
  catalogCode String? @map("catalog_code")
  taxonomyVersion Int? @map("taxonomy_version")
  attributeSchema Json @default("[]") @map("attribute_schema")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId, name])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  name               String
  sku                String
  productType        String?   @map("product_type")
  attributes         Json      @default("{}")
  barcode            String?
  gtin               String?
  brand              String?
  // The additive four-division migration creates tenant-scoped foreign keys for these IDs.
  // Keep their Prisma scalar fields synchronized so generated Product types can read/write them.
  catalogBrandId     String?   @map("catalog_brand_id") @db.Uuid
  catalogModelId     String?   @map("catalog_model_id") @db.Uuid
  unitOfMeasure      String?   @map("unit_of_measure")
  unitOfMeasureId    String?   @map("unit_of_measure_id") @db.Uuid
  defaultTaxCodeId   String?   @map("default_tax_code_id") @db.Uuid
  trackLot           Boolean   @default(false) @map("track_lot")
  trackSerial        Boolean   @default(false) @map("track_serial")
  supplierSku        String?   @map("supplier_sku")
  categoryId         String?   @map("category_id") @db.Uuid
  costPriceMinor     Int       @default(0) @map("cost_price_minor")
  sellingPriceMinor  Int       @default(0) @map("selling_price_minor")
  lowStockThreshold  Decimal   @default(0) @map("low_stock_threshold") @db.Decimal(12, 3)
  trackStock         Boolean   @default(true) @map("track_stock")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements     StockMovement[]
  saleLines          SaleLine[]
  saleReturnLines    SaleReturnLine[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id], map: "product_packages_product_identity_idx")
  @@index([tenantId, active, name])
  @@index([tenantId, categoryId])
  @@index([tenantId, catalogBrandId], map: "products_catalog_brand_idx")
  @@index([tenantId, catalogModelId], map: "products_catalog_model_idx")
  @@map("products")
}

model ModuleRecord {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  moduleId  String   @map("module_id")
  recordId  String   @map("record_id")
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, moduleId, recordId])
  @@index([tenantId, branchId, moduleId, updatedAt])
  @@map("module_records")
}


model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  productId    String            @map("product_id") @db.Uuid
  type         StockMovementType
  quantityDelta Decimal          @map("quantity_delta") @db.Decimal(12, 3)
  unitCostMinor  Int              @default(0) @map("unit_cost_minor")
  warehouseId    String?          @map("warehouse_id") @db.Uuid
  binId          String?          @map("bin_id") @db.Uuid
  lotId          String?          @map("lot_id") @db.Uuid
  variantId      String?          @map("variant_id") @db.Uuid
  serialId       String?          @map("serial_id") @db.Uuid
  reason       String
  sourceId     String?           @map("source_id")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, branchId, productId, createdAt])
  @@map("stock_movements")
}

model Sale {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  branchId            String          @map("branch_id") @db.Uuid
  receiptNumber       String          @map("receipt_number")
  customerName        String?         @map("customer_name")
  customerPhone       String?         @map("customer_phone")
  customerRecordId    String?         @map("customer_record_id")
  opportunityRecordId String?         @map("opportunity_record_id")
  salespersonEmployeeId String?       @map("salesperson_employee_id") @db.Uuid
  cashierUserId        String?         @map("cashier_user_id") @db.Uuid
  receiptBusinessSnapshot Json?       @map("receipt_business_snapshot")
  cashTenderedMinor     Int?           @map("cash_tendered_minor")
  cashChangeMinor       Int?           @map("cash_change_minor")
  promisedPaymentDate DateTime?       @map("promised_payment_date") @db.Date
  totalMinor          Int             @map("total_minor")
  status              String          @default("completed")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines               SaleLine[]
  payments            SalePayment[]
  returns             SaleReturn[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, branchId, customerRecordId])
  @@index([tenantId, branchId, opportunityRecordId])
  @@index([tenantId, branchId, salespersonEmployeeId])
  @@map("sales")
}

model SaleLine {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  saleId              String   @map("sale_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  unitOfMeasureId     String?  @map("unit_of_measure_id") @db.Uuid
  taxCodeId           String?  @map("tax_code_id") @db.Uuid
  taxRateBasisPoints  Int      @default(0) @map("tax_rate_basis_points")
  taxMinor            Int      @default(0) @map("tax_minor")
  taxableMinor        Int      @default(0) @map("taxable_minor")
  taxReferenceDocumentVersion Int? @map("tax_reference_document_version")
  taxCodeSnapshot     String?  @map("tax_code_snapshot")
  taxDescriptionSnapshot String? @map("tax_description_snapshot")
  taxRuleVersionId    String?  @map("tax_rule_version_id") @db.Uuid
  taxCalculationMethod String? @map("tax_calculation_method")
  taxRoundingMethod   String?  @map("tax_rounding_method")
  taxReferenceDocumentVersionId String? @map("tax_reference_document_version_id") @db.Uuid
  priceListId         String?  @map("price_list_id") @db.Uuid
  lotId               String?  @map("lot_id") @db.Uuid
  serialIds           String[] @default([]) @map("serial_ids") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  variantDescriptionSnapshot String? @map("variant_description_snapshot")
  unitNameSnapshot String? @map("unit_name_snapshot")
  serialNumbersSnapshot String[] @default([]) @map("serial_numbers_snapshot")
  warrantyMonthsSnapshot Int? @map("warranty_months_snapshot")
  skuSnapshot         String?  @map("sku_snapshot")
  barcodeSnapshot     String?  @map("barcode_snapshot")
  quantity            Decimal  @db.Decimal(12, 3)
