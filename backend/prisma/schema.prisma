generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum StockMovementType {
  opening
  receiving
  sale
  return
  adjustment
  transfer_in
  transfer_out
  write_off
}

model Tenant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  businessType       String              @default("general") @map("business_type")
  currency           String              @default("UGX")
  timezone           String              @default("Africa/Kampala")
  enabledModules     String[]            @default([]) @map("enabled_modules")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  branches           Branch[]
  auditEvents        AuditEvent[]
  idempotencyRecords IdempotencyRecord[]
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  categories         Category[]
  products           Product[]
  moduleRecords      ModuleRecord[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleLines          SaleLine[]
  salePayments       SalePayment[]
  saleReturns        SaleReturn[]
  saleReturnLines    SaleReturnLine[]

  @@map("tenants")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  displayName        String?              @map("display_name")
  passwordHash       String?              @map("password_hash")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  auditEvents        AuditEvent[]        @relation("AuditActor")
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Membership {
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      String           @default("member")
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([tenantId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Branch {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  code           String
  name           String
  address        String?
  timezone       String         @default("Africa/Kampala")
  currency       String         @default("UGX")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  moduleRecords  ModuleRecord[]
  stockMovements StockMovement[]
  sales          Sale[]
  saleReturns    SaleReturn[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("branches")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  key            String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  name               String
  sku                String
  barcode            String?
  brand              String?
  unitOfMeasure      String?   @map("unit_of_measure")
  supplierSku        String?   @map("supplier_sku")
  categoryId         String?   @map("category_id") @db.Uuid
  costPriceMinor     Int       @default(0) @map("cost_price_minor")
  sellingPriceMinor  Int       @default(0) @map("selling_price_minor")
  lowStockThreshold  Decimal   @default(0) @map("low_stock_threshold") @db.Decimal(12, 3)
  trackStock         Boolean   @default(true) @map("track_stock")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements     StockMovement[]
  saleLines          SaleLine[]
  saleReturnLines    SaleReturnLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@index([tenantId, categoryId])
  @@map("products")
}

model ModuleRecord {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  moduleId  String   @map("module_id")
  recordId  String   @map("record_id")
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, moduleId, recordId])
  @@index([tenantId, branchId, moduleId, updatedAt])
  @@map("module_records")
}


model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  productId    String            @map("product_id") @db.Uuid
  type         StockMovementType
  quantityDelta Decimal          @map("quantity_delta") @db.Decimal(12, 3)
  reason       String
  sourceId     String?           @map("source_id")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, branchId, productId, createdAt])
  @@map("stock_movements")
}

model Sale {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  branchId            String          @map("branch_id") @db.Uuid
  receiptNumber       String          @map("receipt_number")
  customerName        String?         @map("customer_name")
  customerPhone       String?         @map("customer_phone")
  promisedPaymentDate DateTime?       @map("promised_payment_date") @db.Date
  totalMinor          Int             @map("total_minor")
  status              String          @default("completed")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines               SaleLine[]
  payments            SalePayment[]
  returns             SaleReturn[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, branchId, createdAt])
  @@map("sales")
}

model SaleLine {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  saleId              String   @map("sale_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  quantity            Decimal  @db.Decimal(12, 3)
  unitPriceMinor      Int      @map("unit_price_minor")
  lineTotalMinor      Int      @map("line_total_minor")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnLines         SaleReturnLine[]

  @@index([tenantId, saleId])
  @@map("sale_lines")
}

model SalePayment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  saleId     String   @map("sale_id") @db.Uuid
  kind       String   @default("receipt")
  method     String
  amountMinor Int     @map("amount_minor")
  reference  String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, saleId, createdAt])
  @@map("sale_payments")
}

model SaleReturn {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  saleId         String            @map("sale_id") @db.Uuid
  returnNumber   String            @map("return_number")
  totalMinor     Int               @map("total_minor")
  reason         String
  refundRecorded Boolean           @default(false) @map("refund_recorded")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale           Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  lines          SaleReturnLine[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, saleId, createdAt])
  @@map("sale_returns")
}

model SaleReturnLine {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  returnId            String         @map("return_id") @db.Uuid
  originalSaleLineId  String         @map("original_sale_line_id") @db.Uuid
  productId           String         @map("product_id") @db.Uuid
  productNameSnapshot String         @map("product_name_snapshot")
  quantity            Decimal        @db.Decimal(12, 3)
  unitPriceMinor      Int            @map("unit_price_minor")
  lineTotalMinor      Int            @map("line_total_minor")
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returnRecord        SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  originalSaleLine    SaleLine       @relation(fields: [originalSaleLineId], references: [id], onDelete: Restrict)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, returnId])
  @@index([tenantId, originalSaleLineId])
  @@map("sale_return_lines")
}
