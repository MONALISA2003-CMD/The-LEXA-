{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source":"/api/v1/health/live","destination":"https://lexa-demo-api.onrender.com/health/live"},
    {"source":"/api/v1/health/ready","destination":"https://lexa-demo-api.onrender.com/health/ready"},
    {"source":"/api/v1/:path*","destination":"https://lexa-demo-api.onrender.com/api/v1/:path*"},
    {"source":"/(.*)","destination":"/index.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"}]},
    {"source":"/api/v1/(.*)","headers":[{"key":"Cache-Control","value":"private, no-store"}]},
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
  ]
}
