  @Get('auth/recovery/status')
  recoveryStatus(): { available: boolean } {
    return { available: Boolean(process.env.PASSWORD_RESET_DELIVERY_URL || (process.env.RESEND_API_KEY && process.env.PASSWORD_RESET_FROM_EMAIL)) };
  }

  @Post('auth/password/forgot')
  @UseGuards(CsrfGuard)
  @HttpCode(202)
  async forgotPassword(@Body() raw: unknown, @Req() request: FastifyRequest): Promise<{ accepted: true }> {
    const startedAt = Date.now();
    const body = asObject(raw);
    const email = requiredString(body.email, 'Email', 254).toLowerCase();
    const deliveryUrl = process.env.PASSWORD_RESET_DELIVERY_URL;
    const resendAvailable = Boolean(process.env.RESEND_API_KEY && process.env.PASSWORD_RESET_FROM_EMAIL);
    if (!deliveryUrl && !resendAvailable) {
      throw new ServiceUnavailableException({ code: 'PASSWORD_RESET_DELIVERY_NOT_CONFIGURED', message: 'Password recovery email is not configured. Contact your LEXA administrator.' });
    }
    const emailBucket = this.authRateKey('recovery-email', email);
    const ipBucket = this.authRateKey('recovery-ip', this.authIp(request));
    const emailAllowed = await this.consumeAuthRateLimit(emailBucket, 3, 60 * 60 * 1000);
    const ipAllowed = await this.consumeAuthRateLimit(ipBucket, 12, 60 * 60 * 1000);
    if (!emailAllowed || !ipAllowed) throw new HttpException({ statusCode: 429, code: 'RECOVERY_RATE_LIMITED', message: 'Too many recovery requests. Wait before trying again.' }, 429);
    const frontendUrl = (process.env.FRONTEND_PUBLIC_URL ?? 'https://lexareview.vercel.app').replace(/\/$/, '');
    const user = await this.prisma.user.findUnique({ where: { email } });
    if (user) {
      const rawToken = randomBytes(32).toString('base64url');
      const tokenHash = sha256(rawToken);
      await this.prisma.passwordResetToken.deleteMany({ where: { userId: user.id, consumedAt: null } });
      await this.prisma.passwordResetToken.create({ data: { userId: user.id, tokenHash, expiresAt: new Date(Date.now() + RESET_SECONDS * 1000) } });
      const resetUrl = `${frontendUrl}/reset-password?token=${encodeURIComponent(rawToken)}`;
      const name = escapeEmailHtml(user.displayName || 'there');
      const html = `<!doctype html><html><body style="margin:0;background:#f4f7fc;font-family:Arial,sans-serif;color:#10264a"><div style="max-width:560px;margin:32px auto;background:#fff;border:1px solid #e0e8f3;border-radius:16px;padding:32px"><p style="font-weight:800;letter-spacing:2px;color:#075cf5">LEXA</p><h1 style="font-size:24px">Reset your LEXA password</h1><p>Hello ${name},</p><p>We received a request to reset your password. This link can be used once and expires in 30 minutes.</p><p><a href="${resetUrl}" style="display:inline-block;padding:13px 20px;border-radius:10px;background:#075cf5;color:#fff;text-decoration:none;font-weight:700">Create a new password</a></p><p>If you did not request this change, you can ignore this email. Your password will remain unchanged.</p><p style="font-size:12px;color:#64748b">For your protection, do not forward this link.</p></div></body></html>`;
      const text = `Hello ${user.displayName || 'there'},\n\nUse this one-time LEXA password reset link (expires in 30 minutes):\n${resetUrl}\n\nIf you did not request this, ignore this email.`;
      try {
        if (deliveryUrl) {
          const response = await fetch(deliveryUrl, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: user.email, displayName: user.displayName, resetUrl, expiresInMinutes: RESET_SECONDS / 60 }),
          });
          if (!response.ok) throw new Error(`Delivery returned ${response.status}`);
        } else {
          await this.deliverSecurityEmail(user.email, 'Reset your LEXA password', html, text);
        }
      } catch {
        await this.prisma.passwordResetToken.deleteMany({ where: { tokenHash } });
        // Keep the public response identical so account existence is not disclosed.
        console.error('LEXA password recovery delivery failed. Check the configured email provider.');
      }
    }
    // Add a small lower-bound delay so non-existent accounts do not return immediately.
    const remaining = 300 - (Date.now() - startedAt);
    if (remaining > 0) await new Promise((resolve) => setTimeout(resolve, remaining));
    return { accepted: true };
  }
