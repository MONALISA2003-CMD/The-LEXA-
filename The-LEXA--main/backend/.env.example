# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=10000
# Use a disposable development/CI branch. Never point local migrations at production.
DATABASE_URL=postgresql://lexa_app:REPLACE_ME@YOUR_NEON_HOST/lexa?sslmode=require
# Enable only after migration 20261030320000_platform_catalog_finance_rls is applied.
DATABASE_RUNTIME_ROLE=lexa_app_runtime
# Comma-separated exact origins; never use wildcard origins with credentials.
FRONTEND_ORIGINS=http://localhost:5173,https://lexareview.vercel.app
FRONTEND_PUBLIC_URL=https://lexareview.vercel.app
# Required for password recovery and workspace invitations. Use a verified sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LEXA <Info@amaalcredit.com>
LEXA_SUPPORT_EMAIL=Info@amaalcredit.com

# Workstream 7 platform operations (API + separate background worker)
R2_ACCOUNT_ID=
R2_BUCKET=lexa-private-platform-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
REDIS_URL=redis://localhost:6379
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
WORKER_DATABASE_URL=
METRICS_TOKEN=
PLATFORM_RESTORE_ENABLED=false
PLATFORM_ENCRYPTION_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Increment 3-5 platform worker (server-only; never expose via VITE_/NEXT_PUBLIC_)
REDIS_URL=rediss://:replace-me@private-redis:6379
WORKER_DATABASE_URL=postgresql://worker-role:replace-me@db-host/lexa?sslmode=require
CLAMAV_HOST=private-clamav.internal
CLAMAV_PORT=3310
R2_ACCOUNT_ID=replace-me
R2_BUCKET=lexa-private-platform-files
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
BACKUP_ENCRYPTION_KEY=base64-encoded-32-byte-key
BACKUP_KEY_VERSION=v1
PLATFORM_RESTORE_ENABLED=false
RESTORE_TARGET_DATABASE_URL=
RESTORE_TARGET_PROJECT_ID=
RESTORE_TARGET_BRANCH_ID=
PRODUCTION_NEON_PROJECT_ID=
PRODUCTION_NEON_BRANCH_ID=
