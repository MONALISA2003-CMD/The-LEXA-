# Production deployments must use the real server API; this does not enable a backend by itself.
VITE_DATA_PROVIDER=api
# Backend origin, e.g. https://api.example.com (the client appends /api/v1). Do not put secrets here.
VITE_API_BASE_URL=

# For isolated local development only, create .env.local with VITE_DATA_PROVIDER=local.
# Local mode persists data on this device and is not a shared, production system.
