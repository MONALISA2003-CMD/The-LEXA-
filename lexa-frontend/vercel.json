{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/health/live",
      "destination": "https://lexa-backend-api-live.onrender.com/health/live"
    },
    {
      "source": "/api/v1/health/ready",
      "destination": "https://lexa-backend-api-live.onrender.com/health/ready"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://lexa-backend-api-live.onrender.com/api/v1/:path*"
    },
    {
      "source": "/lexa",
      "destination": "/lexa.html"
    },
    {
      "source": "/features",
      "destination": "/features.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
